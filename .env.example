# Server-only credentials. Never commit .env.
OPENAI_API_KEY=
BROWSERBASE_API_KEY=
# Optional: the project can be inferred from the Browserbase API key.
BROWSERBASE_PROJECT_ID=
BELL_MODEL=gpt-5.6-sol
# Page opened by the "Open demo site" button.
BELL_DEMO_URL=https://example.com
# browserbase, local, or auto. local needs a Chrome install and skips Browserbase.
STAGEHAND_BROWSER=browserbase
# Hosted browser logging and recording are always disabled.

# Human handoff (login/OTP/CAPTCHA via Live View). Generate with: openssl rand -base64 32
BELL_PUBLIC_URL=http://127.0.0.1:4320
BELL_HANDOFF_SECRET=
# Optional HTTP Basic access for one trusted operator; password must be at least 32 bytes.
BELL_OPERATOR_USERNAME=
BELL_OPERATOR_PASSWORD=
